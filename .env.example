# Copy to .env and fill in. Every language reads the same variables.

# --- Unaligned account ---
# API key of the account to top up (a reseller's customer key gets 403).
UNALIGNED_KEY=
# API base, no trailing slash. Leave as is unless told otherwise.
#UNALIGNED_API=https://api.unaligned.pw/v1

# --- What to pay with ---
# A pair from GET /payments/methods. Tron is not supported by this example yet.
# networks: bitcoin, litecoin, monero, ethereum, bsc, solana
NETWORK=bsc
# BTC, LTC, XMR, ETH, SOL, USDT, USDC
COIN=USDT

# --- When and how much ---
# Top up when the balance drops below this many USD (number > 0).
THRESHOLD_USD=10
# Whole dollars per top-up (>= the method's min_usd, <= max_usd).
TOPUP_USD=50
# Hard cap on what is sent in any 24 hours, whole dollars (>= TOPUP_USD).
MAX_PER_DAY_USD=100
# Seconds between checks in watch mode (minimum 15).
#CHECK_INTERVAL=60
# 1 = create the payment and print what would be sent; send nothing, write no state.
#DRY_RUN=0
# Where an incomplete invoice payment goes back to.
# Default: the wallet's own address (EVM, Solana); none otherwise.
#REFUND_ADDRESS=
# Progress file. Do not delete it while a payment is in flight.
#STATE_FILE=./autopay-state.json
# Override the built-in USDT/USDC contract (ethereum, bsc) or mint (solana).
#TOKEN_ADDRESS=

# --- Wallet: ethereum, bsc ---
#EVM_RPC_URL=
#EVM_PRIVATE_KEY=

# --- Wallet: solana ---
#SOLANA_RPC_URL=
# Base58 secret key, or the JSON byte array of a solana-keygen file.
#SOLANA_PRIVATE_KEY=

# --- Wallet: bitcoin, litecoin (node wallet RPC) ---
# The URL may include /wallet/<name>.
#WALLET_RPC_URL=
#WALLET_RPC_USER=
#WALLET_RPC_PASSWORD=

# --- Wallet: monero (monero-wallet-rpc) ---
# User and password are optional (digest auth).
#MONERO_WALLET_RPC_URL=
#MONERO_WALLET_RPC_USER=
#MONERO_WALLET_RPC_PASSWORD=
